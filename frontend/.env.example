# For web dev, leave this unset — requests stay relative and hit the same
# origin (works with Vite's dev server / your web host as-is).
#
# For native builds (Capacitor iOS/Android), the app has no "same origin" to
# be relative to — it MUST point at your deployed backend's real URL:
# VITE_API_BASE_URL=https://api.yourapp.com
VITE_API_BASE_URL=
