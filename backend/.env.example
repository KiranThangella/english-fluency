PORT=4000
# Comma-separated list — add every origin that needs to call this backend
# (local dev AND your deployed frontend URL, at the same time, no trailing slashes).
CORS_ORIGIN=http://localhost:5173,https://english-fluency-app.pages.dev
APP_URL=http://localhost:5173

# Required — generate a random 32+ char string (e.g. `openssl rand -hex 32`).
# Signs login sessions; changing it logs everyone out.
JWT_SECRET=replace-with-a-long-random-string

# Daily per-user call caps (resets at UTC midnight). Skipped entirely for
# users on the "premium" plan. Protects your API bill from a single chatty
# free user. Raise/remove once you're comfortable with real usage patterns.
FREE_CHAT_DAILY_LIMIT=20
FREE_GRAMMAR_DAILY_LIMIT=30

# Stripe (optional — billing routes return 501 until these are set).
# Create a recurring monthly Price in the Stripe dashboard for STRIPE_PRICE_ID.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` (dev) or your webhook
# endpoint's settings page (prod) — needed to mark a user "premium" after checkout.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PRICE_ID=price_your_premium_plan_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Comma-separated, tried left to right. A provider is skipped if its key
# below is missing, and skipped (with a fallthrough to the next) if the
# call fails for any reason (network error, non-2xx, empty response).
# Default if unset: anthropic
PROVIDER_ORDER=anthropic,openai,gemini

# Only the keys for providers you actually list above are required.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# Email (optional — password reset & verification links are logged to the
# console instead of sent if this isn't set, so both are fully testable
# without an email provider in local dev).
# Get a free key at https://resend.com — swap emailSender.ts if you use a
# different provider.
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=English Fluency <onboarding@resend.dev>

# Analytics dashboard access (GET /api/analytics/summary) — comma-separated
# list of emails allowed to view it. Empty/unset = nobody can, even you.
ADMIN_EMAILS=you@example.com
